[Unit]
Description=Yinbo AI Infra Service
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=yinbo
Group=yinbo
WorkingDirectory=/opt/yinbo-agent
Environment=TZ=Asia/Shanghai
ExecStart=/usr/bin/java -Xms256m -Xmx512m -jar /opt/yinbo-agent/apps/yinbo-ai-infra.jar
SuccessExitStatus=143
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
